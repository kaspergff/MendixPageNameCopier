{
  "manifest_version": 3,
  "name": "Mendix Page Name Copier",
  "version": "1.0",
  "description": "Kopieert de Mendix paginanaam met een sneltoets",
  "permissions": ["scripting", "activeTab", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy-page-name": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Kopieer Mendix paginanaam"
    }
  },
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
